# Copy to .env. Local development (npm run dev) needs nothing in here:
# it starts its own Postgres and generates secrets in .data/.

# ---- Required for production (docker compose up) ----
# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
AUTH_SECRET=
# Encrypts scripts, variables, API keys and run outputs at rest. Do not change it once data exists.
ENCRYPTION_KEY=

# ---- Optional ----
# Public URL, used for Google sign-in redirects and secure cookies (https).
APP_URL=
PORT=3000

# Set to false to stop new sign-ups. The first account can always be created.
ALLOW_REGISTRATION=true
# Creates this account on startup if it does not exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google sign-in. Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email notifications. Example: smtps://user:password@smtp.example.com:465
SMTP_URL=
SMTP_FROM=ScriptBench <alerts@example.com>

# Server-wide Gemini key. People can also add their own in the app.
GEMINI_API_KEY=

# Runs beyond this many wait in a queue and start when a slot frees up.
MAX_CONCURRENT_RUNS=3
MAX_RUN_SECONDS=600
# Per-user storage for run outputs and uploads, in MB. 0 means no limit.
STORAGE_QUOTA_MB=0
# Run history and outputs older than this are deleted. 0 keeps them forever.
RETENTION_DAYS=30

# Point local development at an existing database instead of the bundled one.
# DATABASE_URL=postgres://user:password@localhost:5432/scriptbench
